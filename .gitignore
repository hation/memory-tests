# 测试输出（运行产物，不入库）
memory_results/
output/

# 另一个独立项目（disk-tests），不纳入本仓库
disk-tests/

# Windows 临时文件
Thumbs.db
Desktop.ini
*.log

# 交付 zip（构建产物，不入库）
*.zip
*.zip.tmp
*.zip.bak

# Python 字节码缓存（db/ 运行产物，不入库）
__pycache__/
*.py[cod]

# SDD 工作区（git-ignored scratch）
.superpowers/

# 测试结果输出（与 scripts 平级的独立目录）
results/

# 本地临时工作区（实测输出，不入库）
tmp/

# 便携 Python（内置工具，已入库：repo 根 tools/python/ 与 kit 镜像 memtest/tools/python/ 同步提交，
# 保证 clone 后 db 历史库与 ISO 重建零下载；勿再忽略）

# ISO 构建工具（构建机本地下载，不入库；qemu 按需 -DownloadQemu 获取）
# 注：GRUB 2.06（tools/grub）已随本项目入库（约 3.8MB），保证离线构建 ISO；
#     含中间斜杠的 pattern 相对 .gitignore 所在目录锚定，故仓库根与 kit 副本各列一条
tools/qemu/
memtest/tools/qemu/
